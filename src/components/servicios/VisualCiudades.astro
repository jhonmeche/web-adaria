---
// Diagrama de la landing "Ciudades inteligentes": la calle es literalmente el
// cable. Un mapa urbano mínimo (cuadras reales, no una rejilla decorativa)
// donde 6 sensores de la ciudad enrutan su dato por las mismas calles del
// mapa hasta la manzana central, que resuelve todo en un solo número en
// vivo — la misma promesa del sitio ("del sensor a la decisión") pero
// contada con el vocabulario de una ciudad. Maqueta ilustrativa, no datos
// reales de un cliente.
const nodos = [
  {
    t: 'Movilidad',
    cx: 100,
    cy: 70,
    path: 'M100,70 V190 H320',
    delay: 0,
    icon: 'M3 8h13m0 0-4-4m4 4-4 4M21 16H8m0 0 4 4m-4-4 4-4',
  },
  {
    t: 'Calidad del aire',
    cx: 320,
    cy: 70,
    path: 'M320,70 V190',
    delay: 0.5,
    icon: 'M5 13a10 10 0 0 1 14 0M8.5 16.5a5 5 0 0 1 7 0M2 9.5a15 15 0 0 1 20 0M12 20h.01',
  },
  {
    t: 'Seguridad',
    cx: 540,
    cy: 70,
    path: 'M540,70 V190 H320',
    delay: 1,
    icon: 'M3 8V6a3 3 0 0 1 3-3h2M16 3h2a3 3 0 0 1 3 3v2M21 16v2a3 3 0 0 1-3 3h-2M8 21H6a3 3 0 0 1-3-3v-2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  },
  {
    t: 'Alumbrado',
    cx: 100,
    cy: 310,
    path: 'M100,310 V190 H320',
    delay: 1.5,
    icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-6 6c0 2.5 1.5 4 2.5 5h7c1-1 2.5-2.5 2.5-5a6 6 0 0 0-6-6Z',
  },
  {
    t: 'Agua',
    cx: 540,
    cy: 310,
    path: 'M540,310 V190 H320',
    delay: 2,
    icon: 'M12 3C12 3 6 10 6 14a6 6 0 0 0 12 0c0-4-6-11-6-11Z',
  },
  {
    t: 'Gestión de riesgo',
    cx: 320,
    cy: 310,
    path: 'M320,310 V190',
    delay: 2.5,
    icon: 'M12 3 2 20h20L12 3ZM12 9v5M12 17h.01',
  },
];
---

<div class="ciudad-visual mt-10 rounded-2xl border border-white/10 bg-ink-card p-6 sm:p-8" data-reveal>
  <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm font-semibold text-on-dark">Así se ve la ciudad conectada</p>
    <p class="inline-flex items-center gap-1.5 text-xs text-muted-dark">
      <svg class="h-3.5 w-3.5 text-brand-400" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16V4m0 0-5 5m5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      6 sensores urbanos, un solo tablero
    </p>
  </div>

  <svg viewBox="0 0 640 360" class="h-auto w-full" aria-hidden="true">
    <!-- Las calles del mapa: mismas líneas que llevan el dato -->
    <g class="calles">
      <path d="M100,40 V340" />
      <path d="M320,40 V340" />
      <path d="M540,40 V340" />
      <path d="M70,70 H570" />
      <path d="M70,190 H570" />
      <path d="M70,310 H570" />
    </g>

    <!-- Pulsos de dato viajando por la calle real hasta la manzana central -->
    {nodos.map((n) => (
      <circle class="city-pulse" r="3.4" style={`offset-path: path('${n.path}'); --pulse-delay:${n.delay}s`} />
    ))}

    <!-- Sensores de la ciudad -->
    {nodos.map((n) => (
      <g class="city-node" style={`--ring-delay:${n.delay}s`}>
        <circle class="node-ring" cx={n.cx} cy={n.cy} r="16" />
        <circle class="node-badge" cx={n.cx} cy={n.cy} r="15" />
        <g transform={`translate(${n.cx - 9},${n.cy - 9}) scale(0.75)`}>
          <path class="node-icon" d={n.icon} />
        </g>
        <text class="node-label" x={n.cx} y={n.cy + 32}>{n.t}</text>
      </g>
    ))}

    <!-- Manzana central: donde la ciudad se resuelve en un número -->
    <g class="hub">
      <circle class="hub-glow" cx="320" cy="190" r="58" />
      <rect class="hub-panel" x="250" y="148" width="140" height="84" rx="14" />
      <g transform="translate(305,160) scale(0.85)">
        <path class="hub-icon" d="M4 21h16M4 21V10l8-5 8 5v11M9 21v-6h6v6" />
      </g>
      <text class="hub-count" x="320" y="203" text-anchor="middle" data-count="182">0</text>
      <text class="hub-caption" x="320" y="220" text-anchor="middle">sensores conectados</text>
    </g>
  </svg>
</div>

<style>
  .calles path {
    fill: none;
    stroke: rgba(121, 161, 255, 0.22);
    stroke-width: 1.5;
  }

  .city-pulse {
    fill: var(--color-brand-400);
    filter: drop-shadow(0 0 6px rgba(121, 161, 255, 0.85));
    opacity: 0;
    offset-rotate: 0deg;
  }

  .node-badge {
    fill: var(--color-brand);
  }
  .node-icon {
    fill: none;
    stroke: #fff;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node-ring {
    fill: none;
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .node-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    fill: var(--color-muted-dark);
    text-anchor: middle;
  }

  .hub-glow {
    fill: color-mix(in srgb, var(--color-brand-400) 50%, transparent);
    filter: blur(20px);
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0.4;
  }
  .hub-panel {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(121, 161, 255, 0.32);
    stroke-width: 1.5;
  }
  .hub-icon {
    fill: none;
    stroke: var(--color-brand-400);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hub-count {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 600;
    fill: var(--color-on-dark);
  }
  .hub-caption {
    font-family: var(--font-sans);
    font-size: 10.5px;
    fill: var(--color-muted-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    .city-pulse {
      animation: flow-pulse 3.6s ease-in-out infinite;
      animation-delay: var(--pulse-delay, 0s);
    }
    .city-node .node-ring {
      animation: node-ping 3.6s ease-out infinite;
      animation-delay: var(--ring-delay, 0s);
    }
    .hub-glow {
      animation: hub-breathe 4.2s ease-in-out infinite;
    }
  }

  @keyframes node-ping {
    0% { transform: scale(0.7); opacity: 0; }
    30% { opacity: 0.5; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  @keyframes hub-breathe {
    0%, 100% { opacity: 0.32; transform: scale(0.95); }
    50% { opacity: 0.52; transform: scale(1.04); }
  }
</style>
