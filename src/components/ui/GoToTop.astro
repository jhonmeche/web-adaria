---
// Botón flotante "volver arriba". Apilado sobre WhatsAppButton (bottom-6
// right-6, ~56px de alto) con espacio de respiro entre ambos. Fondo sólido
// de marca (no la tarjeta oscura) para que se lea también sobre las
// secciones oscuras del sitio, donde una tarjeta oscura sobre fondo oscuro
// se pierde. El aro es un indicador de progreso de scroll (0–100% de la
// página): discreto, no animado por sí solo (solo sigue el scroll). Entrada
// con la misma curva de easing (quint ease-out) que el resto de reveals del
// sitio — sin rebote — para verse consistente y profesional.
const RADIUS = 26;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
---

<div
  data-gototop
  class="fixed bottom-[calc(7rem+env(safe-area-inset-bottom))] right-6 z-50 opacity-0 translate-y-2 scale-90 [transition:opacity_.3s_ease,transform_.4s_cubic-bezier(0.16,1,0.3,1)]"
>
  <button
    type="button"
    aria-label="Volver arriba"
    title="Volver arriba"
    class="group relative grid h-14 w-14 place-items-center rounded-full bg-brand text-white shadow-lg shadow-brand/25 transition-[transform,box-shadow,background-color] duration-200 ease-out hover:-translate-y-1 hover:bg-brand-600 hover:shadow-xl hover:shadow-brand/35 active:scale-95 active:duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  >
    <svg class="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 56 56" aria-hidden="true">
      <circle cx="28" cy="28" r={RADIUS} fill="none" stroke="white" stroke-opacity="0.28" stroke-width="2" />
      <circle
        data-gtt-ring
        cx="28"
        cy="28"
        r={RADIUS}
        fill="none"
        stroke="white"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray={CIRCUMFERENCE}
        stroke-dashoffset={CIRCUMFERENCE}
        style="transition: stroke-dashoffset 0.1s linear;"
      />
    </svg>

    <svg class="relative z-10 h-5 w-5 transition-transform duration-300 ease-out group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5" />
      <path d="M5 12l7-7 7 7" />
    </svg>

    <span
      class="pointer-events-none absolute right-full top-1/2 mr-3 hidden -translate-y-1/2 whitespace-nowrap rounded-md bg-ink-card px-2.5 py-1.5 text-xs font-medium text-on-dark opacity-0 shadow-lg shadow-black/25 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 sm:block"
    >
      Volver arriba
    </span>
  </button>
</div>

<style>
  :global(html.gtt-show) [data-gototop] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  :global(html.gtt-hide-for-form) [data-gototop] {
    opacity: 0 !important;
    pointer-events: none !important;
  }
  [data-gototop] {
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-gototop] {
      transition-duration: 0.15s !important;
      transition-timing-function: linear !important;
      transform: none !important;
    }
  }
  /* Sin JS no hay forma de saber la posición de scroll ni de desplazar
     suavemente: el botón no tiene utilidad, se mantiene oculto. */
</style>

<script is:inline define:vars={{ CIRCUMFERENCE }}>
  const wrap = document.querySelector('[data-gototop]');
  const btn = wrap?.querySelector('button');
  const ring = wrap?.querySelector('[data-gtt-ring]');
  const root = document.documentElement;

  const showAt = () => Math.min(480, window.innerHeight * 0.6);

  const onScroll = () => {
    if (window.scrollY > showAt()) root.classList.add('gtt-show');
    else root.classList.remove('gtt-show');

    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    ring?.setAttribute('stroke-dashoffset', String(CIRCUMFERENCE * (1 - progress)));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  // Oculta "volver arriba" mientras el usuario tiene el foco dentro del
  // formulario de contacto, para no competir con los campos ni con el
  // teclado virtual en móvil.
  const contactForm = document.getElementById('contact-form');
  contactForm?.addEventListener('focusin', () => root.classList.add('gtt-hide-for-form'));
  contactForm?.addEventListener('focusout', (e) => {
    if (!contactForm.contains(e.relatedTarget)) root.classList.remove('gtt-hide-for-form');
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>
