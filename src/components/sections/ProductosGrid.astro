---
// Grid de productos reutilizable: misma card que usa Stack.astro en la home,
// también usado por /productos (hub de productos).
import Viewfinder from '../ui/Viewfinder.astro';
import CheckIcon from '../ui/CheckIcon.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import { productos } from '../../data/productos.ts';
---

<div class="mt-16 grid items-stretch gap-6 lg:grid-cols-3">
  {productos.map((p, i) => (
    <article
      data-reveal
      class:list={[
        'card group relative flex flex-col rounded-2xl border bg-ink-card p-8 hover:[translate:0_-6px]',
        p.destacado
          ? 'border-brand/40 shadow-lg shadow-brand/10 ring-1 ring-brand/20 hover:shadow-xl hover:shadow-brand/15'
          : 'border-white/10 ring-1 ring-white/5 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/10',
      ]}
      style={`--reveal-delay:${i * 90}ms`}
    >
      <Viewfinder on="dark" size="sm" />
      <div class="mb-5">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand text-white shadow-lg shadow-brand/30">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={p.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>

      <p class="text-sm font-medium text-brand-400">{p.categoria}</p>
      <h3 class="mt-1 text-2xl font-semibold text-on-dark">{p.nombre}</h3>
      <p class="mt-3 text-base font-medium leading-snug text-on-dark">{p.tagline}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted-dark">{p.descripcion}</p>

      <ul class="mt-6 space-y-3 border-t border-white/10 pt-6">
        {p.puntos.map((pt) => (
          <li class="flex items-start gap-2.5 text-sm text-on-dark">
            <CheckIcon class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
            {pt}
          </li>
        ))}
      </ul>

      <a
        href={`/productos/${p.slug}`}
        aria-label={`Conocer más sobre ${p.nombre}`}
        class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-semibold text-brand-400 transition-all group-hover:gap-2.5"
      >
        Conocer más
        <ArrowIcon class="h-4 w-4" />
      </a>
    </article>
  ))}
</div>
