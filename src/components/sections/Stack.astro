---
// §9.4 — El stack integral de AdariA: 3 productos + servicios. Fondo oscuro
// (alterna con Sectores -clara- antes y Calidad del dato -clara- después).
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import ProductosGrid from './ProductosGrid.astro';
---

<Section theme="dark" id="productos" grid={true} aria-labelledby="productos-title">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <Eyebrow on="dark" index={8}>El stack integral</Eyebrow>
    <h2 id="productos-title" data-reveal class="text-balance text-h1 font-semibold text-on-dark">
      Tres productos.<br class="hidden sm:block" /> Un solo aliado tecnológico.
    </h2>
    <p data-reveal class="mt-6 max-w-xl text-balance text-lg leading-relaxed text-muted-dark">
      Software, visión artificial y hardware IoT que trabajan juntos y se
      adaptan a cada operación con desarrollo a la medida.
    </p>
  </div>

  <ProductosGrid />

  <p data-reveal class="mt-12 text-center text-sm text-muted-dark">
    ¿Necesita algo distinto? También desarrollamos
    <a href="#servicios" class="font-semibold text-brand-400 hover:underline">soluciones a la medida</a>.
  </p>
</Section>

<style>
  /* Entrada escalonada por card: fade + slide-up con --reveal-delay.
     El reveal usa `transform`; el hover usa la propiedad individual `translate`
     (independiente), así la entrada y el levantamiento al pasar el mouse no se
     pisan y cada uno mantiene su propio tiempo. */
  .js [data-reveal].card {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      translate 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .js [data-reveal].card.is-visible {
    opacity: 1;
    transform: none;
  }
</style>
