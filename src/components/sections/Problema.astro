---
// §9.2 — El problema: el costo de operar a ciegas. Fondo blanco (alterna
// oscuro→blanco→oscuro desde el Hero).
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const dolores = [
  {
    titulo: 'Fallas que detienen la operación',
    texto:
      'Las paradas no planeadas y el mantenimiento reactivo pueden generar sobrecostos significativos. Cuando salta la alerta, el daño ya está hecho.',
    icon: 'alert',
  },
  {
    titulo: 'Datos que no generan valor',
    texto:
      'Cámaras, básculas y sensores capturan información que nadie aprovecha. El dato ya existe; las decisiones se siguen tomando sin él.',
    icon: 'data',
  },
  {
    titulo: 'Procesos manuales y a ciegas',
    texto:
      'Conteos, inspecciones y registros a mano: lentos, costosos y propensos a errores. Sin datos confiables, los problemas se detectan demasiado tarde.',
    icon: 'eye',
  },
];

const icons: Record<string, string> = {
  alert: 'M12 9v4m0 4h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z',
  data: 'M4 6c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3Zm0 0v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3',
  eye: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
};
---

<Section theme="white" id="problema" aria-labelledby="problema-title">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <Eyebrow on="light" index={1}>El costo de operar a ciegas</Eyebrow>
    <h2 id="problema-title" data-reveal class="text-balance text-h1 font-semibold text-on-light">
      Lo que no se mide, se paga caro.
    </h2>
    <p data-reveal class="mt-6 max-w-xl text-balance text-lg leading-relaxed text-muted">
      En la industria, la falta de datos a tiempo se traduce en paradas, riesgos
      y sobrecostos. El problema no es la tecnología: es operar sin ver.
    </p>
  </div>

  <div class="mt-16 grid items-stretch gap-6 md:grid-cols-3">
    {dolores.map((d, i) => (
      <div
        data-reveal
        class="card group relative flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-light p-8 pl-9 ring-1 ring-ink/5 hover:[translate:0_-6px] hover:border-brand/30 hover:shadow-lg"
        style={`--reveal-delay:${i * 90}ms`}
      >
        <!-- Marca lateral de "hallazgo": el acento se enciende al inspeccionar -->
        <span class="absolute inset-y-0 left-0 w-1 bg-brand/20 transition-colors duration-300 group-hover:bg-brand" aria-hidden="true"></span>
        <div class="mb-6 flex items-center justify-between gap-4">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand/10 text-brand ring-1 ring-inset ring-brand/15 transition-colors group-hover:bg-brand group-hover:text-white group-hover:ring-brand">
            <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={icons[d.icon]} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="nums-tabular font-mono text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-on-light/35">Riesgo {String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-on-light">{d.titulo}</h3>
        <p class="text-sm leading-relaxed text-muted">{d.texto}</p>
      </div>
    ))}
  </div>
</Section>

