---
// Grid de servicios (capacidades) reutilizable: misma card que usa
// Servicios.astro en la home, también usado por /servicios (hub de servicios).
// Acepta un prop `items` opcional para filtrar qué servicios mostrar.
import type { Servicio } from '../../data/servicios.ts';
import { servicios } from '../../data/servicios.ts';
import ArrowIcon from '../ui/ArrowIcon.astro';

interface Props {
  /** Servicios a listar. Por defecto, TODOS (incluye Ciudades inteligentes). */
  items?: Servicio[];
}
const { items = servicios } = Astro.props;
---

<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((c, i) => (
    <article
      data-reveal
      class="card service-card group relative flex flex-col overflow-hidden rounded-2xl border border-ink/10 bg-light p-8 ring-1 ring-ink/5 hover:border-brand/40 hover:shadow-lg"
      style={`--reveal-delay:${i * 70}ms`}
    >
      <span class="nums-tabular pointer-events-none absolute right-6 top-6 font-mono text-xs font-semibold text-on-light/20 transition-colors group-hover:text-brand/60" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors group-hover:bg-brand group-hover:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d={c.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h3 class="mt-5 text-xl font-semibold text-on-light">{c.nombre}</h3>
      <p class="mt-2 min-h-[4.3rem] text-sm leading-relaxed text-muted">{c.resumen}</p>
      <ul class="mt-5 flex flex-wrap gap-2 border-t border-ink/10 pt-5">
        {c.tags.map((t) => (
          <li class="rounded-full border border-ink/10 bg-surface px-3 py-1 text-xs font-medium text-on-light/75">{t}</li>
        ))}
      </ul>
      <a
        href={`/servicios/${c.slug}`}
        class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-brand transition-all group-hover:gap-2.5"
      >
        Saber más
        <ArrowIcon class="h-4 w-4" />
      </a>
    </article>
  ))}
</div>
