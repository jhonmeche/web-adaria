---
// §4 / §7 — Servicios (capacidades núcleo). Cierra el ancla #servicios que la
// nav enlazaba sin destino. Presenta a AdariA como un equipo de ingeniería
// integral (las capacidades, fondo BLANCO) y luego su metodología de trabajo
// (fondo OSCURO), para seguir la alternancia oscuro→blanco desde el Hero:
// Arquitectura (oscuro) → Servicios/capacidades (blanco) → Servicios/método
// (oscuro) → Sectores (blanco). Reutiliza el patrón visual del sitio (cards data-reveal,
// íconos de trazo, números grandes en hover).
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import ServiciosGrid from './ServiciosGrid.astro';
import { servicios } from '../../data/servicios.ts';

// Las capacidades núcleo del brief (§4) viven en data/servicios.ts y
// alimentan también su landing dedicada (/servicios/[slug]). Aquí solo
// presentamos la card con su ícono de trazo, tags y enlace a "Saber más".
// La sección de metodología (antes la 2ª Section de este componente) se movió
// a /servicios (plan 008).
const serviciosHome = servicios.filter((s) => s.slug !== 'ciudades-inteligentes');
---

<Section theme="white" id="servicios" aria-labelledby="servicios-title">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <Eyebrow on="light" index={6}>Servicios</Eyebrow>
    <h2 id="servicios-title" data-reveal class="text-balance text-h1 font-semibold text-on-light">
      Un equipo de ingeniería integral,<br class="hidden sm:block" /> bajo un mismo techo.
    </h2>
    <p data-reveal class="mt-6 max-w-2xl text-balance text-lg leading-relaxed text-muted">
      Diseñamos el hardware, capturamos el dato, entrenamos los modelos, lo
      integramos y lo devolvemos convertido en decisiones. Capacidades que
      cubren la cadena completa, del sensor a la decisión, con desarrollo a la medida.
    </p>
  </div>

  <!-- Capacidades -->
  <ServiciosGrid items={serviciosHome} />
</Section>

<style>
  /* Reveal escalonado (mismo patrón que el resto de secciones). En estos cards
     evitamos desplazar el elemento en hover: si el cursor cae justo en el borde,
     mover el card cambia el área interactiva y produce parpadeo/borrosidad. */
  .service-card {
    backface-visibility: hidden;
    backdrop-filter: none;
    transition:
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      background-color 0.28s ease;
  }

  .service-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--color-brand);
    opacity: 0.9;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s ease;
  }

  .service-card:hover::before,
  .service-card:focus-within::before {
    transform: scaleX(1);
  }

  .js [data-reveal].card {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .js [data-reveal].card.is-visible {
    opacity: 1;
    transform: none;
  }

</style>
