---
// Diagrama: mini-dashboard ilustrativo. Muestra qué son KPIs, gráficas y alertas
// (es una maqueta visual, no datos reales).
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const box = dark ? 'border-white/10 bg-ink-card' : 'border-ink/10 bg-surface';
const tile = dark ? 'border-white/10 bg-ink/45' : 'border-ink/10 bg-light';
const title = dark ? 'text-on-dark' : 'text-on-light';
const muted = dark ? 'text-muted-dark' : 'text-muted';

const kpis = [
  { label: 'Disponibilidad', valor: '98,6%', delta: '+1,2%', tone: 'ok' },
  { label: 'Equipos OK', valor: '24/26', delta: '92%', tone: 'brand' },
  { label: 'Alertas hoy', valor: '3', delta: '1 crítica', tone: 'warn' },
];
const barras = [
  { h: 42, label: 'L', tone: 'normal' },
  { h: 58, label: 'M', tone: 'normal' },
  { h: 50, label: 'X', tone: 'normal' },
  { h: 74, label: 'J', tone: 'warn' },
  { h: 60, label: 'V', tone: 'normal' },
  { h: 88, label: 'S', tone: 'crit' },
  { h: 72, label: 'D', tone: 'warn' },
];
const pronostico = { h: 66, label: 'Prev.' };
const tonos = [
  { t: 'Normal', color: 'var(--color-brand-400)' },
  { t: 'Atención', color: 'var(--color-warn)' },
  { t: 'Crítico', color: 'var(--color-crit)' },
];
const eventos = [
  { t: 'Temperatura normal', d: 'Rango estable', tone: 'ok', icon: 'M4 10.5 8 14l8-8.5' },
  { t: 'Vibración en aumento', d: 'Tendencia 7 días', tone: 'warn', icon: 'M12 9v4m0 4h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z' },
  { t: 'Motor B-14 observado', d: 'Revisar en turno', tone: 'brand', icon: 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
];
---

<div class={`data-dashboard mt-10 overflow-hidden rounded-2xl border ${box}`} data-reveal>
  <div class="dashboard-top flex flex-col gap-4 border-b border-current/10 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
    <div>
      <p class={`text-sm font-semibold ${title}`}>Así se ve un tablero operativo</p>
      <p class={`mt-1 text-xs ${muted}`}>KPIs, tendencia, predicción y alertas en una sola lectura.</p>
    </div>
    <span class="live-pill inline-flex w-fit items-center gap-1.5 rounded-full bg-ok/15 px-2.5 py-0.5 text-xs font-medium text-ok">
      <span class="h-1.5 w-1.5 rounded-full bg-ok"></span> En vivo
    </span>
  </div>

  <div class="p-5 sm:p-6">
    <div class="grid gap-3 sm:grid-cols-3">
      {kpis.map((k, i) => (
        <div class={`kpi-tile relative overflow-hidden rounded-xl border px-4 py-3 ${tile}`} style={`--kpi-delay:${i * 110}ms`} data-tone={k.tone}>
          <span class="kpi-rail" aria-hidden="true"></span>
          <p class={`text-[11px] font-medium uppercase ${muted}`}>{k.label}</p>
          <div class="mt-1 flex items-end justify-between gap-3">
            <p class={`text-2xl font-semibold leading-none ${title}`}>{k.valor}</p>
            <span class="kpi-delta rounded-full px-2 py-0.5 text-[11px] font-semibold">{k.delta}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-[1.52fr_0.88fr]">
      <div class={`chart-panel relative overflow-hidden rounded-xl border p-4 ${tile}`}>
        <div class="mb-3 flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class={`text-xs font-semibold ${title}`}>Vibración · últimos 7 días</p>
            <p class={`mt-0.5 text-[11px] ${muted}`}>mm/s · umbral preventivo marcado</p>
          </div>
          <div class={`flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] ${muted}`}>
            {tonos.map((tn) => (
              <span class="inline-flex items-center gap-1.5">
                <span class="legend-dot" style={`background:${tn.color}`}></span>{tn.t}
              </span>
            ))}
            <span class="inline-flex items-center gap-1.5">
              <span class="legend-dot legend-dot-forecast"></span>Previsto
            </span>
          </div>
        </div>

        <div class="chart-canvas relative h-64 overflow-hidden rounded-lg border border-current/10 p-4">
          <div class="chart-grid" aria-hidden="true"></div>
          <div class="threshold-line" aria-hidden="true">
            <span class="threshold-tag">Umbral preventivo</span>
          </div>
          <div class="scan-cursor" aria-hidden="true"></div>
          <div class="relative z-10 flex h-[10.75rem] items-end gap-2 sm:gap-2.5">
            {barras.map((b, i) => (
              <div class="bar-slot flex h-full flex-1 flex-col items-center justify-end gap-2">
                <div
                  class="dashboard-bar w-full max-w-12 rounded-t"
                  data-tone={b.tone}
                  style={`height:${b.h}%; --bar-delay:${i * 75}ms`}
                  aria-hidden="true"
                ></div>
                <span class={`text-[10px] font-medium ${muted}`}>{b.label}</span>
              </div>
            ))}
            <div class="bar-slot flex h-full flex-1 flex-col items-center justify-end gap-2">
              <div
                class="forecast-bar w-full max-w-12 rounded-t"
                style={`height:${pronostico.h}%; --bar-delay:${barras.length * 75}ms`}
                aria-hidden="true"
              >
                <span class="forecast-dot" aria-hidden="true"></span>
              </div>
              <span class={`text-[10px] font-medium ${muted}`}>{pronostico.label}</span>
            </div>
          </div>
        </div>
      </div>

      <aside class={`status-panel rounded-xl border p-4 ${tile}`}>
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class={`text-xs font-semibold ${title}`}>Estado del sistema</p>
            <p class={`mt-0.5 text-[11px] ${muted}`}>Lectura consolidada</p>
          </div>
          <svg class="health-ring h-16 w-16" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="24" stroke="currentColor" stroke-opacity="0.13" stroke-width="8" />
            <circle class="ring-value" cx="32" cy="32" r="24" stroke="currentColor" stroke-width="8" stroke-linecap="round" pathLength="100" />
            <text x="32" y="35" text-anchor="middle" class="ring-text">92</text>
          </svg>
        </div>

        <div class="mt-4 space-y-2.5">
          {eventos.map((e, i) => (
            <div class="event-row flex items-start gap-3 rounded-lg border border-current/10 px-3 py-2.5" data-tone={e.tone} style={`--event-delay:${i * 120}ms`}>
              <span class="event-icon mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={e.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="min-w-0">
                <span class={`block text-xs font-semibold ${title}`}>{e.t}</span>
                <span class={`block text-[11px] ${muted}`}>{e.d}</span>
              </span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  .data-dashboard {
    box-shadow:
      0 1px 2px rgba(16, 20, 24, 0.05),
      0 22px 52px rgba(16, 20, 24, 0.08);
  }
  .dashboard-top {
    background:
      radial-gradient(circle at 18% 0%, rgba(37, 99, 217, 0.10), transparent 18rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
  }
  .live-pill span {
    box-shadow: 0 0 0 0 rgba(46, 163, 107, 0.42);
  }
  .kpi-tile {
    min-height: 5.25rem;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .kpi-tile:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-brand) 42%, transparent);
  }
  .kpi-rail {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 3px;
    background: var(--color-brand);
  }
  .kpi-tile[data-tone="ok"] .kpi-rail,
  .kpi-tile[data-tone="ok"] .kpi-delta {
    background: color-mix(in srgb, var(--color-ok) 16%, transparent);
    color: var(--color-ok);
  }
  .kpi-tile[data-tone="ok"] .kpi-rail {
    background: var(--color-ok);
  }
  .kpi-tile[data-tone="warn"] .kpi-rail,
  .kpi-tile[data-tone="warn"] .kpi-delta {
    background: color-mix(in srgb, var(--color-warn) 17%, transparent);
    color: var(--color-warn);
  }
  .kpi-tile[data-tone="warn"] .kpi-rail {
    background: var(--color-warn);
  }
  .kpi-tile[data-tone="brand"] .kpi-delta {
    background: color-mix(in srgb, var(--color-brand) 13%, transparent);
    color: var(--color-brand);
  }
  .legend-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 999px;
    display: inline-block;
  }
  .legend-dot-forecast {
    background: transparent;
    border: 1.5px dashed var(--color-brand-400);
  }
  .chart-canvas {
    background:
      radial-gradient(circle at 80% 12%, rgba(37, 99, 217, 0.13), transparent 16rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
  }
  .chart-grid {
    position: absolute;
    inset: 1rem;
    background-image: linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 100% 25%;
    opacity: 0.08;
  }
  .threshold-line {
    position: absolute;
    z-index: 15;
    inset-inline: 1rem;
    top: 31%;
    border-top: 1px dashed color-mix(in srgb, var(--color-warn) 72%, transparent);
  }
  .threshold-tag {
    position: absolute;
    left: 0;
    top: -0.95rem;
    border-radius: 999px;
    padding: 1px 7px;
    color: var(--color-warn);
    background: color-mix(in srgb, var(--color-warn) 16%, transparent);
    font-size: 0.625rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .scan-cursor {
    position: absolute;
    z-index: 2;
    inset-block: 1rem 2.15rem;
    left: 1rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(180deg, transparent, var(--color-brand-400), transparent);
    opacity: 0;
    box-shadow: 0 0 20px rgba(121, 161, 255, 0.48);
  }
  .bar-slot {
    min-width: 0;
  }
  .dashboard-bar {
    min-height: 8px;
    transform-origin: bottom;
    background: linear-gradient(180deg, var(--color-brand-400), var(--color-brand));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24);
  }
  .dashboard-bar[data-tone="warn"] {
    background: linear-gradient(180deg, #ffd166, var(--color-warn));
  }
  .dashboard-bar[data-tone="crit"] {
    background: linear-gradient(180deg, #ff9b8d, var(--color-crit));
  }
  .forecast-bar {
    position: relative;
    min-height: 8px;
    transform-origin: bottom;
    border: 1.5px dashed color-mix(in srgb, var(--color-brand-400) 65%, transparent);
    border-bottom: none;
    background: color-mix(in srgb, var(--color-brand-400) 10%, transparent);
  }
  .forecast-dot {
    position: absolute;
    left: 50%;
    top: -4px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 999px;
    background: var(--color-brand-400);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-brand-400) 55%, transparent);
  }
  .health-ring {
    color: var(--color-ok);
  }
  .ring-value {
    stroke-dasharray: 92 100;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    filter: drop-shadow(0 0 7px rgba(46, 163, 107, 0.36));
  }
  .ring-text {
    fill: currentColor;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .event-row {
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .event-row:hover {
    transform: translateX(3px);
  }
  .event-row[data-tone="ok"] {
    background: color-mix(in srgb, var(--color-ok) 9%, transparent);
  }
  .event-row[data-tone="warn"] {
    background: color-mix(in srgb, var(--color-warn) 10%, transparent);
  }
  .event-row[data-tone="brand"] {
    background: color-mix(in srgb, var(--color-brand) 9%, transparent);
  }
  .event-icon {
    background: color-mix(in srgb, var(--color-brand) 13%, transparent);
    color: var(--color-brand);
  }
  .event-row[data-tone="ok"] .event-icon {
    background: color-mix(in srgb, var(--color-ok) 15%, transparent);
    color: var(--color-ok);
  }
  .event-row[data-tone="warn"] .event-icon {
    background: color-mix(in srgb, var(--color-warn) 16%, transparent);
    color: var(--color-warn);
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-pill span {
      animation: live-dot 1.8s ease-out infinite;
    }
    .js [data-reveal].is-visible .kpi-tile {
      animation: kpi-in 0.54s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--kpi-delay, 0ms);
    }
    .js [data-reveal].is-visible .dashboard-bar,
    .js [data-reveal].is-visible .forecast-bar {
      animation: bar-grow 0.72s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--bar-delay, 0ms);
    }
    .js [data-reveal].is-visible .forecast-dot {
      animation: forecast-pulse 2.2s ease-out infinite 1s;
    }
    .js [data-reveal].is-visible .scan-cursor {
      animation: scan-cursor 3.4s ease-in-out infinite 0.7s;
    }
    .js [data-reveal].is-visible .event-row {
      animation: event-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--event-delay, 0ms);
    }
    .js [data-reveal].is-visible .ring-value {
      animation: ring-in 1s ease-out both;
    }
  }
  @keyframes live-dot {
    0% { box-shadow: 0 0 0 0 rgba(46, 163, 107, 0.45); }
    75%, 100% { box-shadow: 0 0 0 8px rgba(46, 163, 107, 0); }
  }
  @keyframes kpi-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes bar-grow {
    from { transform: scaleY(0.08); opacity: 0.4; }
    to { transform: scaleY(1); opacity: 1; }
  }
  @keyframes forecast-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-brand-400) 45%, transparent); }
    75%, 100% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-brand-400) 0%, transparent); }
  }
  @keyframes scan-cursor {
    0% { left: 1rem; opacity: 0; }
    12% { opacity: 1; }
    82% { opacity: 1; }
    100% { left: calc(100% - 1rem); opacity: 0; }
  }
  @keyframes event-in {
    from { opacity: 0; transform: translateX(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ring-in {
    from { stroke-dasharray: 0 100; }
    to { stroke-dasharray: 92 100; }
  }
</style>
