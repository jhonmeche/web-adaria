---
// Diagrama: hardware a la medida. Cadena Medir → Procesar → Enviar, la misma
// gramática visual de "Del sensor a la decisión" (línea + pulso + iconos),
// en vez de un dibujo literal de PCB (difícil de leer y poco profesional).
import ArrowIcon from '../ui/ArrowIcon.astro';
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const box = dark ? 'border-white/10 bg-ink-card' : 'border-ink/10 bg-surface';
const panel = dark ? 'border-white/10 bg-ink/40' : 'border-ink/10 bg-light';
const title = dark ? 'text-on-dark' : 'text-on-light';
const muted = dark ? 'text-muted-dark' : 'text-muted';
const chip = dark ? 'border-white/10 bg-white/5 text-on-dark/85' : 'border-ink/10 bg-ink/5 text-on-light/80';
const chipTag = dark
  ? 'border-brand-400/30 bg-brand-400/10 text-brand-400'
  : 'border-brand/25 bg-brand/8 text-brand-ink';

const entregables = ['PCB', 'Firmware', 'Sensores', 'Gateway'];

const pasos = [
  {
    t: 'Medir',
    d: 'El sensor convierte una variable física en señal.',
    tag: 'Sensores',
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
  },
  {
    t: 'Procesar',
    d: 'El microcontrolador filtra, valida y decide.',
    tag: 'PCB + firmware',
    icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 7h10v10H7V7Zm3 3h4v4h-4v-4Z',
  },
  {
    t: 'Enviar',
    d: 'El gateway lleva el dato a la plataforma.',
    tag: 'Gateway',
    icon: 'M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01',
  },
];
---

<div class={`hardware-visual mt-10 rounded-2xl border p-6 sm:p-8 ${box}`} data-reveal>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class={`text-sm font-semibold ${title}`}>Del componente al dispositivo en campo</p>
      <p class={`mt-1 text-xs ${muted}`}>Diseño electrónico propio, firmware y conectividad listos para producción.</p>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {entregables.map((e) => (
        <span class={`rounded-full border px-2.5 py-0.5 text-xs ${chip}`}>{e}</span>
      ))}
    </div>
  </div>

  <div class={`relative rounded-xl border p-6 sm:p-8 ${panel}`}>
    {/* Línea-cadena Medir → Procesar → Enviar, con pulso que recorre el
       flujo en bucle (mismo lenguaje visual que "Del sensor a la decisión"). */}
    <div
      aria-hidden="true"
      class="absolute inset-x-[13%] top-11 hidden h-px -translate-y-1/2 overflow-hidden bg-linear-to-r from-transparent via-brand/25 to-transparent sm:block"
    >
      <span class="flow-dot absolute inset-y-0 left-0 w-16 bg-linear-to-r from-transparent via-brand to-transparent"></span>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {pasos.map((p, i) => (
        <div class={`hw-step relative rounded-xl border p-5 ${box}`} style={`--step-delay:${i * 140}ms`}>
          <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand text-white shadow-lg shadow-brand/30">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={p.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <p class={`text-sm font-semibold ${title}`}>{p.t}</p>
          <p class={`mt-1 text-xs leading-relaxed ${muted}`}>{p.d}</p>
          <span class={`mt-3 inline-block rounded-full border px-2.5 py-0.5 text-[11px] font-medium ${chipTag}`}>{p.tag}</span>

          {i < pasos.length - 1 && (
            <div class="absolute -right-4 top-11 z-10 hidden h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full bg-brand text-white shadow-lg shadow-brand/40 sm:flex">
              <ArrowIcon class="hw-arrow h-3.5 w-3.5" strokeWidth="2.2" />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .hw-step {
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hw-step:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-brand) 42%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal].is-visible .hw-step {
      animation: hw-step-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--step-delay, 0ms);
    }
    .hw-arrow {
      animation: hw-arrow-nudge 1.6s ease-in-out infinite;
    }
  }
  @keyframes hw-step-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hw-arrow-nudge {
    0%, 100% { transform: translateX(-1.5px); }
    50% { transform: translateX(1.5px); }
  }
</style>
