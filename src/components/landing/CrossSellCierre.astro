---
// Cierre de landing: cross-sell de items relacionados + CTA final.
// Unifica el bloque que hoy está duplicado en productos/[slug].astro y
// servicios/[slug].astro. El bloque de cierre de sectores/[slug].astro
// tiene un layout distinto y no usa este componente.
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';

interface CrossSellItem {
  slug: string;
  icon: string;
  categoria: string;
  nombre: string;
  tagline?: string;
}

interface Props {
  /** '/productos/' o '/servicios/' — prefijo para construir el href de cada item. */
  hrefBase: '/productos' | '/servicios';
  eyebrowLabel: string; // "Un solo aliado" | "Un equipo integral"
  title: string; // H2 completo, ya interpolado por quien llama
  description: string;
  items: CrossSellItem[];
  /** Clases de grid-cols responsivo para el grid de items. */
  itemsGridCols: string;
  /** Muestra `item.tagline` en cada card si es true. */
  showTagline: boolean;
  itemLinkLabel: string; // "Ver producto" | "Saber más"
  closingTitle: string;
  closingDescription: string;
  closingCtaLabel: string;
  closingCtaHref: string; // siempre '/#contacto' en los dos usos actuales
}

const {
  hrefBase,
  eyebrowLabel,
  title,
  description,
  items,
  itemsGridCols,
  showTagline,
  itemLinkLabel,
  closingTitle,
  closingDescription,
  closingCtaLabel,
  closingCtaHref,
} = Astro.props;

// Mapa de itemsGridCols a clases completas y literales para Tailwind v4.
const itemsGridColsClass: Record<string, string> = {
  'sm:grid-cols-2': 'sm:grid-cols-2',
  'sm:grid-cols-2 lg:grid-cols-3': 'sm:grid-cols-2 lg:grid-cols-3',
};
---

<section class="relative isolate overflow-hidden bg-ink py-24 text-on-dark">
  <div class="tech-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow on="dark">{eyebrowLabel}</Eyebrow>
      <h2 class="text-balance text-h1 font-semibold text-on-dark">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-dark">{description}</p>
    </div>

    <div class={`mt-12 grid gap-5 ${itemsGridColsClass[itemsGridCols]}`}>
      {items.map((item) => (
        <a
          href={`${hrefBase}/${item.slug}`}
          class="group flex items-start gap-4 rounded-2xl border border-white/10 bg-ink-card p-6 ring-1 ring-white/5 transition-all hover:-translate-y-1 hover:border-brand/40"
        >
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/15 text-brand-400 transition-colors group-hover:bg-brand group-hover:text-white">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={item.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <p class="text-xs font-medium text-brand-400">{item.categoria}</p>
            <h3 class="text-lg font-semibold text-on-dark">{item.nombre}</h3>
            {showTagline && item.tagline && (
              <p class="mt-1 text-sm leading-relaxed text-muted-dark">{item.tagline}</p>
            )}
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-400 transition-all group-hover:gap-2.5">
              {itemLinkLabel}
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-14 rounded-3xl border border-white/10 bg-ink-card p-10 text-center ring-1 ring-white/5 sm:p-12">
      <h2 class="text-h2 font-semibold text-on-dark">{closingTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-dark">{closingDescription}</p>
      <div class="mt-7 flex justify-center">
        <Button href={closingCtaHref} variant="primary" on="dark">{closingCtaLabel}</Button>
      </div>
    </div>
  </div>
</section>
