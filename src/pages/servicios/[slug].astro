---
// Landing dedicada de cada servicio (§4/§7). Mismo lenguaje visual que la
// landing de producto (/productos/[slug]): hero oscuro con rejilla, secciones
// alternadas claro/oscuro, cards data-reveal con números grandes en hover y
// cierre con cross-sell + CTA. El contenido vive en data/servicios.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import CheckIcon from '../../components/ui/CheckIcon.astro';
import LandingHero from '../../components/landing/LandingHero.astro';
import CrossSellCierre from '../../components/landing/CrossSellCierre.astro';
import { servicios } from '../../data/servicios.ts';
import { sectores } from '../../data/sectores.ts';
import VisualCiudades from '../../components/servicios/VisualCiudades.astro';
import RiesgoUrbano from '../../components/servicios/RiesgoUrbano.astro';
import { absoluteUrl, canonicalPath, siteConfig } from '../../config/seo';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

const { servicio } = Astro.props;
const d = servicio.detalle;

// Sectores donde más aplica (resuelve slug → objeto para nombre y color).
const relacionados = (d.sectores ?? [])
  .map((slug) => sectores.find((s) => s.slug === slug))
  .filter(Boolean);

// Los otros servicios (cross-sell: "un equipo de ingeniería integral").
const otros = servicios.filter((s) => s.slug !== servicio.slug);

const title = `${servicio.nombre} | AdariA Systems`;
const description = servicio.resumen;
const canonical = absoluteUrl(canonicalPath(Astro.url.pathname), Astro.site?.toString());

// Datos estructurados para SEO (rich results en buscadores).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: servicio.nombre,
      serviceType: servicio.categoria,
      description: servicio.resumen,
      provider: { '@id': `${siteConfig.url}/#organization` },
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/servicios/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: servicio.nombre, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <!-- HERO -->
  <LandingHero
    breadcrumb={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: servicio.nombre }]}
    icon={servicio.icon}
    eyebrowLabel={servicio.categoria}
    title={servicio.nombre}
    tagline={servicio.tagline}
    intro={d.intro}
    ctaPrimaryLabel="Hable con un experto"
    ctaPrimaryHref="/#contacto"
    ctaSecondaryLabel="Ver todos los servicios"
    ctaSecondaryHref="/servicios"
  >
    <ul class="grid gap-3" slot>
      {d.puntos.map((pt) => (
        <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-ink-card p-5 ring-1 ring-white/5">
          <CheckIcon class="mt-0.5 h-5 w-5 shrink-0 text-brand-400" />
          <span class="text-sm font-medium text-on-dark">{pt}</span>
        </li>
      ))}
    </ul>
    {servicio.slug === 'ciudades-inteligentes' && (
      <Fragment slot="extra"><VisualCiudades /></Fragment>
    )}
  </LandingHero>

  <!-- QUÉ HACEMOS -->
  <Section theme="light" id="que-hacemos">
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow on="light">Qué hacemos</Eyebrow>
      <h2 data-reveal class="text-balance text-h1 font-semibold text-on-light">{d.queHacemosTitulo}</h2>
      {d.queHacemosIntro && (
        <p data-reveal class="mt-5 text-lg leading-relaxed text-muted">{d.queHacemosIntro}</p>
      )}
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {d.capacidades.map((c, i) => {
        const esUltimaImpar = d.capacidades.length % 2 === 1 && i === d.capacidades.length - 1;
        return (
        <article
          data-reveal
          class={`card flex flex-col rounded-2xl border border-ink/10 bg-surface p-8 shadow-sm ring-1 ring-ink/5 hover:[translate:0_-6px] hover:border-brand/30 hover:shadow-lg ${esUltimaImpar ? 'md:col-span-2' : ''}`}
          style={`--reveal-delay:${i * 80}ms`}
        >
          <h3 class="text-xl font-semibold text-on-light">{c.titulo}</h3>
          {c.descripcion && <p class="mt-1 text-sm font-medium text-brand">{c.descripcion}</p>}
          <ul class={`mt-5 grid gap-2.5 border-t border-ink/5 pt-5 ${esUltimaImpar ? 'sm:grid-cols-2' : ''}`}>
            {c.items.map((it) => (
              <li class="flex items-start gap-2.5 text-sm text-on-light">
                <CheckIcon class="mt-0.5 h-4 w-4 shrink-0 text-brand" />
                {it}
              </li>
            ))}
          </ul>
        </article>
        );
      })}
    </div>
  </Section>

  {/* Profundización en gestión del riesgo — solo Ciudades inteligentes */}
  {servicio.slug === 'ciudades-inteligentes' && <RiesgoUrbano />}

  <!-- CÓMO TRABAJAMOS + STACK -->
  <Section theme="dark" id="como-trabajamos" grid={true}>
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow on="dark">Cómo trabajamos</Eyebrow>
      <h2 data-reveal class="text-balance text-h1 font-semibold text-on-dark">
        Un método de equipo, no improvisación.
      </h2>
      <p data-reveal class="mt-5 text-lg leading-relaxed text-muted-dark">
        Empezamos acotado y de bajo riesgo, validamos en campo y escalamos a su operación.
      </p>
    </div>

    <ol class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {d.proceso.map((paso, i) => (
        <li
          data-reveal
          class="card group relative flex flex-col rounded-2xl border border-white/10 bg-ink-card p-7 ring-1 ring-white/5 hover:[translate:0_-4px] hover:border-brand/40 hover:shadow-xl hover:shadow-brand/10"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <span
            aria-hidden="true"
            data-count={String(i + 1)}
            data-pad="2"
            class="inline-block origin-top-left text-6xl font-bold leading-none tracking-tight text-white/10 transition-all duration-300 group-hover:scale-110 group-hover:text-brand-400"
          >{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-lg font-semibold text-on-dark">{paso.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-dark">{paso.texto}</p>
        </li>
      ))}
    </ol>

    <!-- Stack / entregables -->
    <div data-reveal class="mt-12 flex flex-col items-center gap-5 border-t border-white/10 pt-10 text-center">
      <p class="text-sm font-medium text-muted-dark">Stack y entregables</p>
      <ul class="flex flex-wrap justify-center gap-2.5">
        {d.entregables.map((t) => (
          <li class="rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm font-medium text-on-dark/80">{t}</li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- BENEFICIOS -->
  <Section theme="light" id="beneficios">
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow on="light">Por qué AdariA</Eyebrow>
      <h2 data-reveal class="text-balance text-h1 font-semibold text-on-light">Lo que gana su operación.</h2>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {d.beneficios.map((b, i) => (
        <div
          data-reveal
          class="card group flex flex-col rounded-2xl border border-ink/10 bg-surface p-7 shadow-sm ring-1 ring-ink/5 hover:[translate:0_-4px] hover:border-brand/40 hover:shadow-lg"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <span
            aria-hidden="true"
            data-count={String(i + 1)}
            data-pad="2"
            class="inline-block origin-top-left text-6xl font-bold leading-none tracking-tight text-ink/10 transition-all duration-300 group-hover:scale-110 group-hover:text-brand"
          >{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-base font-semibold text-on-light">{b.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{b.texto}</p>
        </div>
      ))}
    </div>

    {relacionados.length > 0 && (
      <div class="mt-14 border-t border-ink/10 pt-10 text-center">
        <p class="text-sm font-medium text-muted">Donde más aplica</p>
        <div class="mt-4 flex flex-wrap justify-center gap-2.5">
          {relacionados.map((s) => (
            <a href={`/sectores/${s!.slug}`} class="rounded-full border border-ink/15 bg-ink/5 px-4 py-1.5 text-sm font-medium text-on-light transition-colors hover:border-brand/40 hover:text-brand">
              {s!.nombre}
            </a>
          ))}
        </div>
      </div>
    )}
  </Section>

  <!-- CIERRE: equipo integral (cross-sell) + CTA -->
  <CrossSellCierre
    hrefBase="/servicios"
    eyebrowLabel="Un equipo integral"
    title={`${servicio.nombre} es una de nuestras capacidades.`}
    description="Del sensor a la decisión: combinamos capacidades para cubrir la cadena completa —a la medida y con dato auditable— bajo un mismo techo."
    items={otros}
    itemsGridCols="sm:grid-cols-2 lg:grid-cols-3"
    showTagline={false}
    itemLinkLabel="Saber más"
    closingTitle="¿Existe un reto técnico por resolver?"
    closingDescription="Cuéntenos su operación y diseñamos la solución a la medida —con hardware, software y datos— que de verdad necesita."
    closingCtaLabel="Hable con un experto"
    closingCtaHref="/#contacto"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>
